# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
# Full Postgres connection string (Railway, Supabase, etc.).
# If left unset, the app falls back to a local SQLite file (local.db).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI providers ---
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Stripe ---
STRIPE_API_KEY=sk_live_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Cloudflare R2 (S3-compatible storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=vincicut-videos

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Auth ---
# Random secret used to sign JWT auth tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse an example/default value here.
SECRET_KEY=

# --- Misc ---
FRONTEND_URL=https://www.vincicutai.com
